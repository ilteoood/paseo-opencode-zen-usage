{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "jsx": "react-jsx",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["bun", "react"]
  },
  "include": ["index.client.tsx", "index.server.ts", "client", "server", "shared", "test"]
}
